{
  "app": "npx ts-node --prefer-ts-exts infra/bin/app.ts",
  "watch": {
    "include": ["infra/**/*.ts", "services/**/*.ts", "src/**/*.ts"],
    "exclude": ["cdk.out/**", "node_modules/**", "test/**"]
  },
  "context": {
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "availability-zones:account=123456789012:region=us-east-1": [
      "us-east-1a",
      "us-east-1b"
    ]
  }
}
