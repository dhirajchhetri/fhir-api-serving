{
  "name": "fhir-api-serving",
  "version": "0.1.0",
  "private": true,
  "description": "Wound-care FHIR R4 read API, governed operational analytics, and a clinician risk-score endpoint.",
  "license": "MIT",
  "author": "Dhiraj Chhetri",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "keys": "ts-node scripts/generate-dev-keys.ts",
    "token": "ts-node scripts/mint-token.ts",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "synth": "cdk synth --quiet"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.716.0",
    "@aws-sdk/client-dynamodb": "^3.716.0",
    "@aws-sdk/client-eventbridge": "^3.716.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.716.0",
    "@aws-sdk/credential-provider-node": "^3.716.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "aws4": "^1.13.2",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/testing": "^10.4.15",
    "@types/aws4": "^1.11.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "aws-cdk": "^2.174.0",
    "aws-cdk-lib": "^2.174.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
