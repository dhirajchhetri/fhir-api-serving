PORT=3000
# Local RS256 verifier. Run `npm run keys` to create dev-keys/.
# JWT_PUBLIC_KEY_PATH=dev-keys/jwt-public.pem
# Production: set JWKS_URI to the Cognito user pool and JWT_ISSUER / JWT_AUDIENCE to match.
# JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/POOL_ID/.well-known/jwks.json
# JWT_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/POOL_ID
# JWT_AUDIENCE=woundcare-api
JWT_ISSUER=local-dev
JWT_AUDIENCE=woundcare-api

FHIR_BACKEND=memory
# FHIR_BACKEND=healthlake
# HEALTHLAKE_BASE_URL=https://healthlake.us-east-1.amazonaws.com/datastore/DATASTORE_ID/r4

ANALYTICS_BACKEND=sqlite
# ANALYTICS_BACKEND=athena
# ATHENA_WORKGROUP=woundcare-tenant-demo
# ATHENA_DATABASE=woundcare_curated
# ATHENA_OUTPUT=s3://woundcare-athena-results/results/

RISK_BACKEND=reference
# RISK_BACKEND=sagemaker
# SAGEMAKER_ENDPOINT=woundcare-nonhealing-risk

# REDIS_URL=redis://localhost:6379
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AUDIT_BUCKET=woundcare-audit
# IDEMPOTENCY_TABLE=woundcare-idempotency

SEED=true
SNAPSHOT_DATE=2026-10-15
DEFAULT_TIME_START=2026-01-01
DEFAULT_TIME_END=2027-01-01
